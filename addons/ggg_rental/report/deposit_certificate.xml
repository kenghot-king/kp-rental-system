<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ใบมัดจำ (Deposit Certificate) report action.
        Renders the Thai invoice/receipt layout in deposit-certificate mode
        (see report_invoice_thai.xml: report_deposit_certificate_thai).
    -->
    <record id="action_report_deposit_certificate" model="ir.actions.report">
        <field name="name">Deposit Certificate (ใบมัดจำ)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ggg_rental.report_deposit_certificate_thai</field>
        <field name="report_file">ggg_rental.report_deposit_certificate_thai</field>
        <field name="print_report_name">'Deposit Certificate-%s' % (object._deposit_certificate_so_number())</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>
</odoo>
